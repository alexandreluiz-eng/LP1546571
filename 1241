using System;

class Program
{
    static void Main()
    {
        int N = int.Parse(Console.ReadLine());

        while (N-- > 0)
        {
            string[] entrada = Console.ReadLine().Split(' ');
            string A = entrada[0];
            string B = entrada[1];

            if (B.Length > A.Length)
            {
                Console.WriteLine("nao encaixa");
            }
            else
            {
                if (A.EndsWith(B))
                {
                    Console.WriteLine("encaixa");
                }
                else
                {
                    Console.WriteLine("nao encaixa");
                }
            }
        }
    }
}
